<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANTILLA DE REFERENCIA para el web.config de PRODUCCION en IIS.

  NO se usa en build/publish. `dotnet publish -c Release` genera su propio
  web.config; despues de publicar, edita ese web.config generado (en la
  carpeta de salida) para que quede como este: lo unico que hay que agregar
  al autogenerado es el bloque <environmentVariables> con ASPNETCORE_ENVIRONMENT.

  El atributo `processPath="dotnet"` + `arguments=".\SalesApp.Api.dll"` es lo
  que genera publish para un deploy "framework-dependent" (requiere el .NET 8
  Hosting Bundle instalado en el servidor). No lo cambies.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\SalesApp.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- CRITICO: sin esto, SeedController/ConfigController/Swagger quedarian expuestos. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
